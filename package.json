{
  "name": "url-to-pdf-api",
  "version": "1.0.0",
  "description": "Web page PDF rendering done right. Packaged to an easy API.",
  "overrides": {
    "diff": "^9.0.0"
  },
  "type": "commonjs",
  "main": "src/index.js",
  "engines": {
    "node": ">=24.x.x"
  },
  "scripts": {
    "start": "env-cmd -f .env-cmdrc.json -- nodemon -r newrelic --watch ./src -e js src/index.js",
    "build": "babel src --out-dir dist",
    "test": "mocha --timeout 10000",
    "fix-lint": "eslint ./src ./test --fix",
    "fix-fmt": "prettier -c ./src --config ./.prettierrc ./test --write",
    "lint": "eslint .",
    "fmt": "prettier -c ./src ./test --config ./.prettierrc",
    "prod:start": "node -r newrelic dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvarcarto/url-to-pdf-api.git"
  },
  "author": "Kimmo Brunfeldt",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alvarcarto/url-to-pdf-api/issues"
  },
  "homepage": "https://github.com/alvarcarto/url-to-pdf-api#readme",
  "dependencies": {
    "body-parser": "^2.3.0",
    "compression": "^1.8.1",
    "core-js": "^3.48.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-prom-bundle": "^8.0.0",
    "express-validation": "^4.1.1",
    "lodash": "^4.18.0",
    "morgan": "^1.11.0",
    "normalize-url": "^9.0.0",
    "pdf-parse": "^2.4.5",
    "prom-client": "^15.1.3",
    "puppeteer": "^25.8.0",
    "regenerator-runtime": "^0.14.1",
    "server-destroy": "^1.0.1",
    "winston": "^3.19.0",
    "newrelic": "^14.3.8"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.0",
    "@babel/core": "^8.0.0",
    "@babel/node": "^8.0.0",
    "@babel/preset-env": "^8.0.0",
    "@babel/register": "^8.0.0",
    "@eslint/js": "^10.0.1",
    "@isaacs/brace-expansion": ">=5.0.1",
    "chai": "^6.2.2",
    "env-cmd": "^11.0.0",
    "eslint": "^10.0.3",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-flat-config-airbnb": "^2.0.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.4.0",
    "minimatch": "^10.2.4",
    "mocha": "^12.0.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "tar": "^7.5.11"
  },
  "resolutions": {
    "diff": "^9.0.0",
    "minimatch": "^10.2.4",
    "@isaacs/brace-expansion": ">=5.0.1",
    "tar": "^7.5.11",
    "flatted": "^3.4.0",
    "serialize-javascript": "^7.0.4"
  }
}
